# Токен для API Wildberries
# Получить можно в личном кабинете WB: Настройки → Доступ к API
WB_TOKEN=your_wb_api_token_here

# ИНН вашей организации
SELLER_INN=123456789012

# ФИАС ID вашего места деятельности (МОД)
# Можно найти в личном кабинете Честного Знака или на сайте ФИАС
SELLER_FIAS_ID=00000000-0000-0000-0000-000000000000